@app.post("/api/control")
async def control_bot(control: StrategyControl):
    if control.action == "START":
        if state.bot_running:
            return {"status": "already_running"}

        state.bot_running = True
        state.bot_mode = control.mode or "PAPER"
        state.current_strategy = control.strategy_name
        state.start_time = datetime.now()

        # ── NEW: Reset strategy instance on start ──
        if state.strategy_instance:
            state.strategy_instance.reset()

        if state.paper_broker:
            state.paper_broker.reset()

        state.bot_task = asyncio.create_task(run_paper_trading())

        state.alerts.append({
            "level": "INFO",
            "message": f"Bot started in {state.bot_mode} mode with strategy '{control.strategy_name}'",
            "timestamp": datetime.now().isoformat()
        })

        await state.manager.broadcast({
            "type": "ALERT",
            "data": {"level": "INFO", "message": f"Bot started in {state.bot_mode} mode"}
        })
        return {"status": "started", "mode": state.bot_mode}

    elif control.action == "STOP":
        state.bot_running = False
        state.start_time = None
        if state.bot_task:
            state.bot_task.cancel()
            try:
                await state.bot_task
            except asyncio.CancelledError:
                pass
            state.bot_task = None

        if state.self_improvement:
            await state.self_improvement.stop()
            state.self_improvement = None

        state.alerts.append({
            "level": "INFO",
            "message": "Bot stopped",
            "timestamp": datetime.now().isoformat()
        })
        return {"status": "stopped"}

    elif control.action == "SQUARE_OFF":
        if state.paper_broker:
            await state.paper_broker.square_off_all(datetime.now())

        state.alerts.append({
            "level": "WARNING",
            "message": "Square off initiated",
            "timestamp": datetime.now().isoformat()
        })

        await state.manager.broadcast({
            "type": "ALERT",
            "data": {"level": "WARNING", "message": "Square off initiated"}
        })
        return {"status": "square_off_initiated"}

    elif control.action == "KILL_SWITCH":
        state.bot_running = False
        if state.bot_task:
            state.bot_task.cancel()
            try:
                await state.bot_task
            except asyncio.CancelledError:
                pass
            state.bot_task = None

        if state.self_improvement:
            await state.self_improvement.stop()
            state.self_improvement = None

        state.alerts.append({
            "level": "CRITICAL",
            "message": "KILL SWITCH ACTIVATED",
            "timestamp": datetime.now().isoformat()
        })

        await state.manager.broadcast({
            "type": "ALERT",
            "data": {"level": "CRITICAL", "message": "KILL SWITCH ACTIVATED"}
        })
        return {"status": "kill_switch_activated"}

    elif control.action == "TOGGLE_SELF_IMPROVE":
        state.self_improvement_enabled = not state.self_improvement_enabled
        status = "enabled" if state.self_improvement_enabled else "disabled"

        state.alerts.append({
            "level": "INFO",
            "message": f"Self-improvement {status}",
            "timestamp": datetime.now().isoformat()
        })
        return {
            "status": f"self_improvement_{status}",
            "enabled": state.self_improvement_enabled,
            "mode": state.bot_mode,
            "strategy": state.current_strategy
        }

    else:
        raise HTTPException(400, f"Unknown action: {control.action}")

@app.post("/api/backtest")
async def run_backtest(request: BacktestRequest):
    """Run backtest synchronously and return full results."""
    try:
        if request.mode == "real":
            # Fetch real historical data
            from backend.historical_data import get_data_provider

            end_dt = request.end_date or datetime.now().strftime("%Y-%m-%d")
            start_dt = request.start_date or (datetime.now() - timedelta(days=request.days)).strftime("%Y-%m-%d")

            provider = get_data_provider(source=request.data_source or "auto")
            data = provider.get_data(
                symbol=request.symbol,
                start_date=start_dt,
                end_date=end_dt,
                interval=request.interval or "5minute"
            )
            print(f"[BACKTEST] Using real data: {request.symbol} from {start_dt} to {end_dt}")

        elif request.mode == "csv" and request.data_path:
            data = DataGenerator.load_csv_data(request.data_path)

        else:
            # ── FIXED: Synthetic data with symbol-specific volatility ──
            data = DataGenerator.generate_synthetic_data(
                days=request.days, 
                symbol=request.symbol,
                seed=None
            )

        strategy_cls = StrategyRegistry.get(request.strategy)
        config_cls = StrategyRegistry.get_config_class(request.strategy)

        config = config_cls(name=request.strategy)
        strategy = strategy_cls(config)
        # ── NEW: Reset strategy before backtest ──
        strategy.reset()

        risk_config = RiskConfig()
        engine = BacktestEngine(strategy, risk_config, data, symbol=request.symbol)
        result = await engine.run()

        # Build full result with all fields the dashboard expects
        import math
        ohlc_data = []
        for idx, row in data.iterrows():
            # Robust timestamp serialization
            if hasattr(idx, 'isoformat'):
                ts = idx.isoformat()
            else:
                ts = str(idx)

            # Sanitize any NaN/inf in OHLC data
            def safe_float(v):
                v = float(v)
                if math.isnan(v) or math.isinf(v):
                    return 0.0
                return round(v, 4)

            ohlc_data.append({
                "timestamp": ts,
                "open": safe_float(row["open"]),
                "high": safe_float(row["high"]),
                "low": safe_float(row["low"]),
                "close": safe_float(row["close"]),
                "volume": int(row["volume"]) if not math.isnan(float(row["volume"])) else 0
            })

        result_data = {
            "strategy": request.strategy,
            "symbol": request.symbol,
            "total_pnl": result.total_pnl,
            "total_pnl_pct": result.total_pnl_pct,
            "win_rate": result.win_rate,
            "sharpe_ratio": result.sharpe_ratio,
            "max_drawdown": result.max_drawdown,
            "total_trades": result.total_trades,
            "profit_factor": 999.99 if result.profit_factor == float("inf") else result.profit_factor,
            "avg_trade_pnl": result.avg_profit_per_trade,
            "max_consecutive_losses": result.max_consecutive_losses,
            "params": result.params if result.params else {},
            "equity_curve": [e["equity"] for e in result.equity_curve] if result.equity_curve else [],
            "trades": result.trades if result.trades else [],
            "ohlc_data": ohlc_data,
            "timestamp": datetime.now().isoformat()
        }
        state.backtest_results.append(result_data)

        return result_data

    except Exception as e:
        import traceback
        error_msg = f"{str(e)}\n{traceback.format_exc()}"
        print(f"[BACKTEST ERROR] {error_msg}")
        raise HTTPException(500, detail=str(e))



@app.post("/api/backtest/compare")
async def compare_strategies(request: StrategyCompareRequest):
    """Run all strategies on identical data and return ranked comparison."""
    try:
        # 1. Load data ONCE (shared across all strategies)
        if request.mode == "real":
            from backend.historical_data import get_data_provider
            end_dt = request.end_date or datetime.now().strftime("%Y-%m-%d")
            start_dt = request.start_date or (datetime.now() - timedelta(days=request.days)).strftime("%Y-%m-%d")
            provider = get_data_provider(source=request.data_source or "auto")
            data = provider.get_data(
                symbol=request.symbol,
                start_date=start_dt,
                end_date=end_dt,
                interval=request.interval or "5minute"
            )
        elif request.mode == "csv" and request.data_path:
            data = DataGenerator.load_csv_data(request.data_path)
        else:
            # ── FIXED: Symbol-specific synthetic data ──
            data = DataGenerator.generate_synthetic_data(
                days=request.days, 
                symbol=request.symbol,
                seed=None
            )

        strategies = StrategyRegistry.list_strategies()
        results = []
        shared_ohlc = None

        # 2. Run each strategy on identical data
        for strat_name in strategies:
            try:
                strategy_cls = StrategyRegistry.get(strat_name)
                config_cls = StrategyRegistry.get_config_class(strat_name)
                config = config_cls(name=strat_name)
                strategy = strategy_cls(config)
                # ── NEW: Reset strategy before each comparison run ──
                strategy.reset()

                risk_config = RiskConfig()
                engine = BacktestEngine(strategy, risk_config, data, symbol=request.symbol)
                result = await engine.run()

                # Build OHLC once
                if shared_ohlc is None and result.trades:
                    import math
                    shared_ohlc = []
                    for idx, row in data.iterrows():
                        ts = idx.isoformat() if hasattr(idx, 'isoformat') else str(idx)
                        def safe_float(v):
                            v = float(v)
                            return 0.0 if math.isnan(v) or math.isinf(v) else round(v, 4)
                        shared_ohlc.append({
                            "timestamp": ts,
                            "open": safe_float(row["open"]),
                            "high": safe_float(row["high"]),
                            "low": safe_float(row["low"]),
                            "close": safe_float(row["close"]),
                            "volume": int(row["volume"]) if not math.isnan(float(row["volume"])) else 0
                        })

                # Composite score
                trade_penalty = -50 if result.total_trades == 0 else 0
                score = (
                    result.total_pnl_pct * 2.0 +
                    result.sharpe_ratio * 10.0 +
                    result.win_rate * 0.5 -
                    result.max_drawdown * 1.5 +
                    trade_penalty
                )

                results.append(StrategyComparisonResult(
                    strategy=strat_name,
                    total_pnl_pct=result.total_pnl_pct,
                    win_rate=result.win_rate,
                    sharpe_ratio=result.sharpe_ratio,
                    max_drawdown=result.max_drawdown,
                    total_trades=result.total_trades,
                    profit_factor=999.99 if result.profit_factor == float("inf") else result.profit_factor,
                    avg_trade_pnl=result.avg_profit_per_trade,
                    score=round(score, 2),
                    trades=result.trades if result.trades else [],
                    ohlc_data=shared_ohlc if strat_name == strategies[0] else None
                ))

            except Exception as e:
                print(f"[COMPARE] Strategy {strat_name} failed: {e}")
                results.append(StrategyComparisonResult(
                    strategy=strat_name,
                    total_pnl_pct=0.0, win_rate=0.0, sharpe_ratio=0.0,
                    max_drawdown=0.0, total_trades=0, profit_factor=0.0,
                    avg_trade_pnl=0.0, score=-999.0, trades=[], ohlc_data=None
                ))

        # 3. Rank by score descending
        results.sort(key=lambda x: x.score, reverse=True)

        # Attach OHLC to winner if missing
        if shared_ohlc and not any(r.ohlc_data for r in results):
            results[0].ohlc_data = shared_ohlc

        return {
            "winner": results[0].strategy if results else None,
            "symbol": request.symbol,
            "data_mode": request.mode,
            "comparisons": [r.model_dump() for r in results],
            "timestamp": datetime.now().isoformat()
        }

    except Exception as e:
        import traceback
        print(f"[COMPARE ERROR] {str(e)}\n{traceback.format_exc()}")
        raise HTTPException(500, detail=str(e))

@app.post("/api/optimize")
async def run_optimization(request: OptimizationRequest):
    """Run optimization synchronously and return full results."""
    try:
        from backend.auto_improvement_agent import AutoImprovementAgent

        # ── FIXED: Symbol-specific synthetic data ──
        data = DataGenerator.generate_synthetic_data(
            days=request.days, 
            symbol=request.symbol,
            seed=None
        )

        agent = AutoImprovementAgent(
            strategy_name=request.strategy,
            data=data,
            output_dir="data/backtest_results"
        )

        if request.mode == "adaptive":
            result = await agent.run_adaptive_search(iterations=request.iterations)
        else:
            result = await agent.run_grid_search(max_combinations=request.iterations)

        if result:
            opt_data = {
                "strategy_name": request.strategy,
                "best_params": result.best_params,
                "best_score": result.best_score,
                "improvement_pct": result.improvement_pct,
                "train_pnl": result.train_results.total_pnl_pct,
                "test_pnl": result.test_results.total_pnl_pct,
                "baseline_score": result.baseline_score,
                "timestamp": datetime.now().isoformat()
            }
            state.optimization_results.append(opt_data)
            return opt_data
        else:
            raise HTTPException(500, detail="Optimization returned no result")

    except Exception as e:
        import traceback
        error_msg = f"{str(e)}\n{traceback.format_exc()}"
        print(f"[OPTIMIZE ERROR] {error_msg}")
        raise HTTPException(500, detail=str(e))


# ---------- WebSocket ----------
@app.websocket("/ws")
async def websocket_endpoint(websocket: WebSocket):
    await state.manager.connect(websocket)
    try:
        await websocket.send_json({
            "type": "STATUS",
            "data": state.get_status().model_dump()
        })

        while True:
            try:
                data = await asyncio.wait_for(websocket.receive_text(), timeout=30.0)
                msg = json.loads(data)
                if msg.get("action") == "ping":
                    await websocket.send_json({
                        "type": "PONG",
                        "timestamp": datetime.now().isoformat()
                    })
            except asyncio.TimeoutError:
                await websocket.send_json({
                    "type": "HEARTBEAT",
                    "timestamp": datetime.now().isoformat()
                })
    except WebSocketDisconnect:
        await state.manager.disconnect(websocket)


