# ---------- Paper Trading Engine ----------
async def run_paper_trading():
    """Main paper trading loop with self-improvement."""
    if state.synthetic_data is None:
        # ── NEW: Generate symbol-specific synthetic data ──
        state.synthetic_data = DataGenerator.generate_synthetic_data(
            days=1, 
            symbol=state.current_strategy or "NIFTY50",
            seed=None
        )
        state.data_index = 0

    if state.strategy_instance is None:
        strategy_cls = StrategyRegistry.get(state.current_strategy or "orb")
        config_cls = StrategyRegistry.get_config_class(state.current_strategy or "orb")

        # Use self-improvement params if available
        params = {}
        if state.self_improvement and state.self_improvement_enabled:
            params = state.self_improvement.get_params_for_trading()
            print(f"[TRADING] Using self-improved params: {params}")

        config = config_cls(name=state.current_strategy or "orb", **params)
        state.strategy_instance = strategy_cls(config)
        # ── NEW: Reset strategy to clean state ──
        state.strategy_instance.reset()

    if state.paper_broker is None:
        state.paper_broker = PaperBroker()

    if state.risk_manager is None:
        state.risk_manager = RiskManager(RiskConfig())

    if state.performance_monitor is None:
        state.performance_monitor = PerformanceMonitor(PerformanceThresholds())

    # Start self-improvement loop if enabled
    if state.self_improvement_enabled and state.self_improvement is None:
        state.self_improvement = SelfImprovementLoop(
            strategy_name=state.current_strategy or "orb",
            config=SelfImprovementConfig(
                check_interval_minutes=5,  # Check every 5 min for demo
                min_trades_before_optimize=5,
                optimization_iterations=20,
                synthetic_days_for_opt=30,
                validation_minutes=10,
                max_param_changes_per_day=5,
                improvement_threshold_pct=5.0
            )
        )
        await state.self_improvement.start()

    data = state.synthetic_data

    while state.bot_running:
        if state.data_index >= len(data):
            # ── NEW: Regenerate with symbol-specific volatility ──
            state.synthetic_data = DataGenerator.generate_synthetic_data(
                days=1, 
                symbol=state.current_strategy or "NIFTY50",
                seed=None
            )
            state.data_index = 0
            data = state.synthetic_data

        row = data.iloc[state.data_index]
        timestamp = data.index[state.data_index]

        # Create bar
        from backend.strategies.strategy import Bar as BarModel
        bar_obj = BarModel(
            symbol="NIFTY50",
            timestamp=timestamp,
            open=row["open"],
            high=row["high"],
            low=row["low"],
            close=row["close"],
            volume=int(row["volume"])
        )
        state.strategy_instance.ingest_bar(bar_obj)

        # ── NEW: Update NSE market data feed periodically ──
        if timestamp.minute % 15 == 0:  # Every 15 minutes
            try:
                if state.risk_manager:
                    await state.nse_data_feed.update_risk_manager(state.risk_manager)
            except Exception as e:
                print(f"[NSE DATA] Feed error: {e}")

        # Generate signal every 5 minutes
        if timestamp.minute % 5 == 0:
            try:
                signal = await state.strategy_instance.generate_signal("NIFTY50", timestamp)

                if signal.action != SignalAction.HOLD:
                    # ── FIXED: Wire risk manager lot size through ──
                    allowed, reason, qty = await state.risk_manager.can_trade(signal, timestamp)

                    if allowed:
                        # ── FIXED: Pass calculated qty to place_order ──
                        pos = await state.paper_broker.place_order(signal, "NIFTY50", timestamp, qty=qty)

                        if pos:
                            alert_msg = f"Paper trade: {signal.action.value} {pos.symbol} @ ₹{pos.entry_price} (qty: {pos.quantity})"
                            state.alerts.append({
                                "level": "INFO",
                                "message": alert_msg,
                                "timestamp": timestamp.isoformat()
                            })

                            # Record in performance monitor
                            if state.performance_monitor:
                                state.performance_monitor.record_equity(
                                    state.paper_broker.get_portfolio_summary()["capital"], 
                                    timestamp
                                )
                    else:
                        state.alerts.append({
                            "level": "WARNING",
                            "message": f"Trade blocked: {reason}",
                            "timestamp": timestamp.isoformat()
                        })

            except Exception as e:
                state.alerts.append({
                    "level": "ERROR",
                    "message": f"Strategy error: {str(e)}",
                    "timestamp": datetime.now().isoformat()
                })

        # Update prices for all positions
        await state.paper_broker.update_prices(row["close"], timestamp)

        # â”€â”€ NEW: Risk manager MTM updates + exit signal checks â”€â”€
        # Enables: trailing stops, breakeven triggers, partial exits, target/SL hits
        if state.risk_manager:
            try:
                rm_positions = await state.risk_manager.get_positions()
                for rm_underlying, rm_pos in rm_positions.items():
                    await state.risk_manager.update_mtm(rm_underlying, row["close"])
                    exit_sig = await state.risk_manager.get_exit_signal(rm_underlying, row["close"])
                    if exit_sig and exit_sig.action == SignalAction.EXIT:
                        ex_ok, ex_reason, ex_qty = await state.risk_manager.can_trade(exit_sig, timestamp)
                        if ex_ok:
                            await state.paper_broker.place_order(exit_sig, rm_underlying, timestamp, qty=ex_qty)
                            state.alerts.append({
                                "level": "WARNING",
                                "message": f"Risk exit: {exit_sig.reason}",
                                "timestamp": timestamp.isoformat()
                            })
            except Exception as e:
                print(f"[RISK EXIT] Error: {e}")

        # Record closed trades to performance monitor
        if state.performance_monitor and state.paper_broker.closed_trades:
            for trade in state.paper_broker.closed_trades:
                if not trade.get("recorded", False):
                    state.performance_monitor.record_trade(
                        pnl=trade["pnl"],
                        entry_time=datetime.fromisoformat(trade["entry_time"]),
                        exit_time=datetime.fromisoformat(trade["exit_time"]),
                        symbol=trade["symbol"],
                        reason=trade["reason"]
                    )
                    trade["recorded"] = True

        # Update portfolio history
        pf = state.paper_broker.get_portfolio_summary()
        state.daily_pnl_history.append({
            "time": timestamp.strftime("%H:%M:%S"),
            "pnl": pf["daily_pnl"],
            "equity": pf["capital"]
        })

        # Broadcast update
        await state.manager.broadcast({
            "type": "PORTFOLIO",
            "data": pf
        })

        # Broadcast positions
        positions = state.paper_broker.get_positions()
        if positions:
            await state.manager.broadcast({
                "type": "POSITIONS",
                "data": positions
            })

        # â”€â”€ NEW: Trim growing lists to prevent memory leaks â”€â”€
        if len(state.alerts) > 500:
            state.alerts = state.alerts[-500:]
        if len(state.daily_pnl_history) > 1000:
            state.daily_pnl_history = state.daily_pnl_history[-1000:]
        if len(state.backtest_results) > 50:
            state.backtest_results = state.backtest_results[-50:]
        if len(state.optimization_results) > 50:
            state.optimization_results = state.optimization_results[-50:]

        state.data_index += 1
        await asyncio.sleep(0.5)  # 0.5s = 1 min market time


# ---------- Background Broadcast ----------
async def broadcast_updates():
    """Broadcast periodic status heartbeats to WebSocket clients."""
    while True:
        await asyncio.sleep(5)
        if state.bot_running:
            await state.manager.broadcast({
                "type": "STATUS",
                "data": state.get_status().model_dump()
            })


# ---------- Lifespan ----------
@asynccontextmanager
async def lifespan(app: FastAPI):
    print("Trading API Server starting...")
    task = asyncio.create_task(broadcast_updates())
    yield
    task.cancel()
    try:
        await task
    except asyncio.CancelledError:
        pass
    print("Trading API Server stopped.")


